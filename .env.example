# =====================================================================
# Mitra Dharma Praja Mart — contoh isi .env
#
# Salin jadi .env, lalu sesuaikan. Nilai di bawah untuk laptop pengembang.
# DI SERVER (hosting), WAJIB ubah baris-baris bertanda [SERVER]. Langkah
# lengkapnya ada di README.md, bagian "Memasang di hosting".
# =====================================================================

APP_NAME="Mitra Dharma Praja Mart"
# [SERVER] production
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
# Buat SEKALI dengan: php artisan key:generate
# JANGAN pernah dibuat ulang setelah aplikasi dipakai: tautan pembayaran di
# invoice WhatsApp yang sudah terkirim ikut tidak berlaku, dan semua orang
# ter-logout.
APP_KEY=
# [SERVER] false  (true menampilkan isi kode ke pengunjung saat ada error)
APP_DEBUG=true
# [SERVER] alamat lengkap website, mis. https://mart.koperasi-mitradharma.id
# Dipakai untuk tautan di invoice WhatsApp, jadi harus benar.
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# [SERVER] Isi * kalau hosting memasang proxy/CDN di depan aplikasi
# (Cloudflare, Render, Railway, dll). Kosongkan kalau tidak.
TRUSTED_PROXIES=

# Akun pengurus pertama, dibuat oleh: php artisan db:seed --force
# [SERVER] WAJIB diisi; seeder menolak jalan kalau password masih bawaan.
ADMIN_EMAIL=admin@mitradharma.test
ADMIN_PASSWORD=admin12345

# Persentase SHU untuk perkiraan di beranda anggota. Kalau MIN = MAKS,
# yang tampil satu angka pasti, bukan rentang.
SHU_PERSEN_MIN=0.5
SHU_PERSEN_MAKS=1.0

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# [SERVER] error
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mitra_dharma_praja_mart
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# [SERVER] true kalau website sudah memakai https
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Aplikasi ini tidak mengirim email (invoice lewat WhatsApp).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
